{
  "name": "chefalarab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-recipe-indexes.mjs && next dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/generate-recipe-indexes.mjs && next build && node scripts/prepare-standalone.mjs",
    "check": "npm run audit && npm run audit:ads && npm run lint && npm run typecheck && npm run build",
    "start": "node .next/standalone/server.js",
    "start:next": "next start",
    "data:generate": "node scripts/generate-recipe-indexes.mjs",
    "clean": "node scripts/clean.mjs",
    "build:clean": "npm run clean && npm run build",
    "audit": "node scripts/audit-project.mjs",
    "audit:strict": "node scripts/audit-project.mjs --strict-assets",
    "audit:ads": "node scripts/audit-monetization.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "next": "^16.3.5",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
